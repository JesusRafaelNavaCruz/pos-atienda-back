generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["negocio", "plataforma"]
}

model Plan {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String          @db.VarChar(100)
  code             String          @unique @db.VarChar(50)
  price_mxn        Decimal         @db.Decimal(10, 2)
  billing_interval BillingInterval @default(monthly)
  max_branches     Int             @default(1)
  max_users        Int             @default(2)
  trial_days       Int             @default(14)
  is_active        Boolean         @default(true)
  created_at       DateTime        @default(now()) @db.Timestamptz(6)
  updated_at       DateTime        @default(now()) @updatedAt @db.Timestamptz(6)
  features         PlanFeature[]
  subscriptions    Subscription[]

  @@map("plans")
  @@schema("plataforma")
}

model PlanFeature {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  plan_id     String @db.Uuid
  feature_key String @db.VarChar(100)
  limit_value String @default("true") @db.VarChar(50)
  plan        Plan   @relation(fields: [plan_id], references: [id], onDelete: Cascade)

  @@unique([plan_id, feature_key])
  @@index([plan_id], map: "idx_plan_features_plan")
  @@map("plan_features")
  @@schema("plataforma")
}

model Tenant {
  id                  String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String              @db.VarChar(200)
  slug                String              @unique @db.VarChar(100)
  status              TenantStatus        @default(active)
  timezone            String              @default("America/Mexico_City") @db.VarChar(60)
  country             String              @default("MX") @db.Char(2)
  logo_url            String?
  created_at          DateTime            @default(now()) @db.Timestamptz(6)
  updated_at          DateTime            @default(now()) @updatedAt @db.Timestamptz(6)
  branches            Branch[]
  categories          Category[]
  customers           Customer[]
  inventory_movements InventoryMovement[]
  payments            Payment[]
  products            Product[]
  purchase_orders     PurchaseOrder[]
  roles               Role[]
  sales               Sale[]
  suppliers           Supplier[]
  user_sessions       UserSession[]
  users               User[]
  billing_events      BillingEvent[]
  subscriptions       Subscription[]

  @@map("tenants")
  @@schema("plataforma")
}

model Subscription {
  id                     String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id              String             @db.Uuid
  plan_id                String             @db.Uuid
  stripe_subscription_id String?            @unique @db.VarChar(200)
  stripe_customer_id     String?            @db.VarChar(200)
  status                 SubscriptionStatus @default(trialing)
  current_period_start   DateTime?          @db.Timestamptz(6)
  current_period_end     DateTime?          @db.Timestamptz(6)
  trial_ends_at          DateTime?          @db.Timestamptz(6)
  canceled_at            DateTime?          @db.Timestamptz(6)
  created_at             DateTime           @default(now()) @db.Timestamptz(6)
  updated_at             DateTime           @default(now()) @updatedAt @db.Timestamptz(6)
  plan                   Plan               @relation(fields: [plan_id], references: [id])
  tenant                 Tenant             @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([tenant_id], map: "idx_subscriptions_tenant")
  @@index([status], map: "idx_subscriptions_status")
  @@map("subscriptions")
  @@schema("plataforma")
}

model BillingEvent {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id       String?  @db.Uuid
  stripe_event_id String   @unique @db.VarChar(200)
  event_type      String   @db.VarChar(100)
  payload         Json     @default("{}")
  processed_at    DateTime @default(now()) @db.Timestamptz(6)
  tenant          Tenant?  @relation(fields: [tenant_id], references: [id])

  @@index([tenant_id], map: "idx_billing_events_tenant")
  @@index([event_type], map: "idx_billing_events_type")
  @@map("billing_events")
  @@schema("plataforma")
}

model AdminUser {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String         @unique @db.VarChar(255)
  password_hash String
  full_name     String         @db.VarChar(200)
  is_active     Boolean        @default(true)
  last_login_at DateTime?      @db.Timestamptz(6)
  created_at    DateTime       @default(now()) @db.Timestamptz(6)
  updated_at    DateTime       @default(now()) @updatedAt @db.Timestamptz(6)
  sessions      AdminSession[]

  @@map("admin_users")
  @@schema("plataforma")
}

model AdminSession {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  admin_user_id      String    @db.Uuid
  refresh_token_hash String    @unique
  expires_at         DateTime  @db.Timestamptz(6)
  created_at         DateTime  @default(now()) @db.Timestamptz(6)
  admin_user         AdminUser @relation(fields: [admin_user_id], references: [id], onDelete: Cascade)

  @@index([admin_user_id], map: "idx_admin_sessions_user")
  @@map("admin_sessions")
  @@schema("plataforma")
}

model Branch {
  id                  String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id           String              @db.Uuid
  name                String              @db.VarChar(200)
  address             String?
  phone               String?             @db.VarChar(30)
  email               String?             @db.VarChar(200)
  is_active           Boolean             @default(true)
  created_at          DateTime            @default(now()) @db.Timestamptz(6)
  updated_at          DateTime            @default(now()) @updatedAt @db.Timestamptz(6)
  tenant              Tenant              @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  inventory_movements InventoryMovement[]
  purchase_orders     PurchaseOrder[]
  sales               Sale[]
  users               User[]

  @@map("branches")
  @@schema("negocio")
}

model Role {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id   String           @db.Uuid
  name        String           @db.VarChar(100)
  code        String           @db.VarChar(50)
  is_system   Boolean          @default(false)
  created_at  DateTime         @default(now()) @db.Timestamptz(6)
  permissions RolePermission[]
  tenant      Tenant           @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  users       User[]

  @@unique([tenant_id, code])
  @@map("roles")
  @@schema("negocio")
}

model Permission {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  resource    String           @db.VarChar(80)
  action      String           @db.VarChar(40)
  description String?          @db.VarChar(255)
  roles       RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
  @@schema("negocio")
}

model RolePermission {
  role_id       String     @db.Uuid
  permission_id String     @db.Uuid
  permission    Permission @relation(fields: [permission_id], references: [id], onDelete: Cascade)
  role          Role       @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@id([role_id, permission_id])
  @@map("role_permissions")
  @@schema("negocio")
}

model User {
  id                  String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id           String              @db.Uuid
  role_id             String              @db.Uuid
  branch_id           String?             @db.Uuid
  email               String              @db.VarChar(255)
  password_hash       String
  full_name           String              @db.VarChar(200)
  pin_hash            String?
  is_active           Boolean             @default(true)
  last_login_at       DateTime?           @db.Timestamptz(6)
  created_at          DateTime            @default(now()) @db.Timestamptz(6)
  updated_at          DateTime            @default(now()) @updatedAt @db.Timestamptz(6)
  inventory_movements InventoryMovement[]
  purchase_orders     PurchaseOrder[]
  sales               Sale[]
  sessions            UserSession[]
  branch              Branch?             @relation(fields: [branch_id], references: [id])
  role                Role                @relation(fields: [role_id], references: [id])
  tenant              Tenant              @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@unique([tenant_id, email])
  @@index([tenant_id], map: "idx_users_tenant")
  @@index([tenant_id, email], map: "idx_users_email")
  @@map("users")
  @@schema("negocio")
}

model UserSession {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id            String   @db.Uuid
  tenant_id          String   @db.Uuid
  refresh_token_hash String   @unique
  ip_address         String?  @db.Inet
  user_agent         String?
  expires_at         DateTime @db.Timestamptz(6)
  created_at         DateTime @default(now()) @db.Timestamptz(6)
  tenant             Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  user               User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id], map: "idx_sessions_user")
  @@index([refresh_token_hash], map: "idx_sessions_token")
  @@map("user_sessions")
  @@schema("negocio")
}

model Category {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id  String    @db.Uuid
  name       String    @db.VarChar(100)
  color      String?   @default("#6B7280") @db.VarChar(7)
  is_active  Boolean   @default(true)
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  tenant     Tenant    @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  products   Product[]

  @@unique([tenant_id, name])
  @@map("categories")
  @@schema("negocio")
}

model Supplier {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id       String          @db.Uuid
  name            String          @db.VarChar(200)
  contact_name    String?         @db.VarChar(200)
  phone           String?         @db.VarChar(30)
  email           String?         @db.VarChar(255)
  rfc             String?         @db.VarChar(13)
  address         String?
  notes           String?
  is_active       Boolean         @default(true)
  created_at      DateTime        @default(now()) @db.Timestamptz(6)
  updated_at      DateTime        @default(now()) @updatedAt @db.Timestamptz(6)
  products        Product[]
  purchase_orders PurchaseOrder[]
  tenant          Tenant          @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([tenant_id], map: "idx_suppliers_tenant")
  @@map("suppliers")
  @@schema("negocio")
}

model Product {
  id                   String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id            String              @db.Uuid
  category_id          String?             @db.Uuid
  supplier_id          String?             @db.Uuid
  barcode              String?             @db.VarChar(100)
  sku                  String?             @db.VarChar(100)
  name                 String              @db.VarChar(300)
  description          String?
  unit                 ProductUnit         @default(pza)
  price                Decimal             @default(0) @db.Decimal(12, 2)
  cost                 Decimal             @default(0) @db.Decimal(12, 2)
  stock                Decimal             @default(0) @db.Decimal(12, 3)
  min_stock            Decimal             @default(0) @db.Decimal(12, 3)
  sold_by_weight       Boolean             @default(false)
  image_url            String?
  is_active            Boolean             @default(true)
  created_at           DateTime            @default(now()) @db.Timestamptz(6)
  updated_at           DateTime            @default(now()) @updatedAt @db.Timestamptz(6)
  inventory_movements  InventoryMovement[]
  category             Category?           @relation(fields: [category_id], references: [id])
  supplier             Supplier?           @relation(fields: [supplier_id], references: [id])
  tenant               Tenant              @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  purchase_order_items PurchaseOrderItem[]
  sale_items           SaleItem[]

  @@unique([tenant_id, barcode])
  @@index([tenant_id], map: "idx_products_tenant")
  @@index([tenant_id, barcode], map: "idx_products_barcode")
  @@map("products")
  @@schema("negocio")
}

model InventoryMovement {
  id              String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id       String                @db.Uuid
  product_id      String                @db.Uuid
  user_id         String?               @db.Uuid
  branch_id       String?               @db.Uuid
  type            InventoryMovementType
  quantity_before Decimal               @db.Decimal(12, 3)
  quantity_after  Decimal               @db.Decimal(12, 3)
  delta           Decimal               @db.Decimal(12, 3)
  reason          String?
  reference_id    String?               @db.Uuid
  created_at      DateTime              @default(now()) @db.Timestamptz(6)
  branch          Branch?               @relation(fields: [branch_id], references: [id])
  product         Product               @relation(fields: [product_id], references: [id])
  tenant          Tenant                @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  user            User?                 @relation(fields: [user_id], references: [id])

  @@index([product_id], map: "idx_inventory_product")
  @@index([tenant_id, created_at], map: "idx_inventory_tenant")
  @@map("inventory_movements")
  @@schema("negocio")
}

model Customer {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id      String   @db.Uuid
  name           String   @db.VarChar(200)
  phone          String?  @db.VarChar(30)
  email          String?  @db.VarChar(255)
  rfc            String?  @db.VarChar(13)
  address        String?
  credit_limit   Decimal  @default(0) @db.Decimal(12, 2)
  credit_balance Decimal  @default(0) @db.Decimal(12, 2)
  loyalty_points Int      @default(0)
  notes          String?
  is_active      Boolean  @default(true)
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  updated_at     DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  tenant         Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  sales          Sale[]

  @@index([tenant_id], map: "idx_customers_tenant")
  @@map("customers")
  @@schema("negocio")
}

model Sale {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id   String     @db.Uuid
  branch_id   String     @db.Uuid
  user_id     String     @db.Uuid
  customer_id String?    @db.Uuid
  folio       String     @db.VarChar(30)
  subtotal    Decimal    @default(0) @db.Decimal(12, 2)
  discount    Decimal    @default(0) @db.Decimal(12, 2)
  total       Decimal    @default(0) @db.Decimal(12, 2)
  status      SaleStatus @default(completed)
  notes       String?
  created_at  DateTime   @default(now()) @db.Timestamptz(6)
  updated_at  DateTime   @default(now()) @updatedAt @db.Timestamptz(6)
  payments    Payment[]
  items       SaleItem[]
  branch      Branch     @relation(fields: [branch_id], references: [id])
  customer    Customer?  @relation(fields: [customer_id], references: [id])
  tenant      Tenant     @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  user        User       @relation(fields: [user_id], references: [id])

  @@unique([tenant_id, folio])
  @@index([tenant_id], map: "idx_sales_tenant")
  @@index([branch_id], map: "idx_sales_branch")
  @@index([user_id], map: "idx_sales_user")
  @@index([tenant_id, created_at], map: "idx_sales_created_at")
  @@map("sales")
  @@schema("negocio")
}

model SaleItem {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sale_id    String  @db.Uuid
  product_id String  @db.Uuid
  quantity   Decimal @db.Decimal(12, 3)
  unit_price Decimal @db.Decimal(12, 2)
  discount   Decimal @default(0) @db.Decimal(12, 2)
  subtotal   Decimal @db.Decimal(12, 2)
  product    Product @relation(fields: [product_id], references: [id])
  sale       Sale    @relation(fields: [sale_id], references: [id], onDelete: Cascade)

  @@index([sale_id], map: "idx_sale_items_sale")
  @@index([product_id], map: "idx_sale_items_product")
  @@map("sale_items")
  @@schema("negocio")
}

model Payment {
  id                 String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sale_id            String        @db.Uuid
  tenant_id          String        @db.Uuid
  method             PaymentMethod
  amount             Decimal       @db.Decimal(12, 2)
  change_given       Decimal       @default(0) @db.Decimal(12, 2)
  stripe_payment_id  String?       @db.VarChar(200)
  stripe_terminal_id String?       @db.VarChar(200)
  card_last4         String?       @db.Char(4)
  card_brand         String?       @db.VarChar(20)
  status             PaymentStatus @default(completed)
  created_at         DateTime      @default(now()) @db.Timestamptz(6)
  sale               Sale          @relation(fields: [sale_id], references: [id], onDelete: Cascade)
  tenant             Tenant        @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([sale_id], map: "idx_payments_sale")
  @@index([tenant_id], map: "idx_payments_tenant")
  @@map("payments")
  @@schema("negocio")
}

model PurchaseOrder {
  id           String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id    String              @db.Uuid
  supplier_id  String              @db.Uuid
  user_id      String?             @db.Uuid
  branch_id    String?             @db.Uuid
  folio        String              @db.VarChar(30)
  status       PurchaseOrderStatus @default(draft)
  total        Decimal             @default(0) @db.Decimal(12, 2)
  notes        String?
  expected_at  DateTime?           @db.Date
  received_at  DateTime?           @db.Timestamptz(6)
  created_at   DateTime            @default(now()) @db.Timestamptz(6)
  updated_at   DateTime            @default(now()) @updatedAt @db.Timestamptz(6)
  public_token String              @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  items        PurchaseOrderItem[]
  branch       Branch?             @relation(fields: [branch_id], references: [id])
  supplier     Supplier            @relation(fields: [supplier_id], references: [id])
  tenant       Tenant              @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  user         User?               @relation(fields: [user_id], references: [id])

  @@unique([tenant_id, folio])
  @@index([tenant_id], map: "idx_purchase_orders_tenant")
  @@map("purchase_orders")
  @@schema("negocio")
}

model PurchaseOrderItem {
  id         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id   String        @db.Uuid
  product_id String        @db.Uuid
  quantity   Decimal       @db.Decimal(12, 3)
  unit_cost  Decimal       @db.Decimal(12, 2)
  subtotal   Decimal       @db.Decimal(12, 2)
  order      PurchaseOrder @relation(fields: [order_id], references: [id], onDelete: Cascade)
  product    Product       @relation(fields: [product_id], references: [id])

  @@map("purchase_order_items")
  @@schema("negocio")
}

enum BillingInterval {
  monthly
  yearly

  @@schema("plataforma")
}

enum TenantStatus {
  active
  suspended
  canceled
  trial

  @@schema("plataforma")
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  canceled
  unpaid

  @@schema("plataforma")
}

enum ProductUnit {
  pza
  kg
  g
  lt
  ml
  caja
  paq
  rollo
  par

  @@schema("negocio")
}

enum InventoryMovementType {
  sale
  purchase
  adjustment
  return
  loss
  initial

  @@schema("negocio")
}

enum SaleStatus {
  pending
  completed
  canceled
  returned

  @@schema("negocio")
}

enum PaymentMethod {
  cash
  card
  transfer
  credit

  @@schema("negocio")
}

enum PaymentStatus {
  pending
  completed
  failed
  refunded

  @@schema("negocio")
}

enum PurchaseOrderStatus {
  draft
  sent
  received
  canceled

  @@schema("negocio")
}
