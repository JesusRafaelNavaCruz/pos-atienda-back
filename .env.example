# ── Servidor ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
API_PREFIX=/api/v1

# ── Base de datos ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/pos_tenda

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=cambia_esto_por_un_secreto_seguro_de_al_menos_32_caracteres
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Stripe ────────────────────────────────────────────────────────────────────
# Obtén estas keys en: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Para desarrollo local, ejecuta:
#   stripe listen --forward-to localhost:3000/webhooks/stripe
# El CLI imprimirá el signing secret (cambia en cada sesión).
# Para producción, cópialo del Dashboard → Developers → Webhooks → tu endpoint.
STRIPE_WEBHOOK_SECRET=whsec_...

# Mercado Pago Point / Terminales Smart
# Nunca expongas MP_ACCESS_TOKEN ni MP_WEBHOOK_SECRET al frontend.
MP_PUBLIC_KEY=APP_USR-...
# Credenciales de TU aplicación Mercado Pago (no de cada comercio).
MP_CLIENT_ID=1234567890
MP_CLIENT_SECRET=tu_client_secret
MP_OAUTH_REDIRECT_URI=https://api.tudominio.com/api/v1/mercadopago/oauth/callback
MP_OAUTH_SUCCESS_URL=https://app.tudominio.com/app/settings?tab=paymentSuppliers
# true solamente al vincular cuentas de prueba/sandbox.
MP_OAUTH_TEST_MODE=false
# 32 bytes codificados base64url. Genera una única vez y guárdala en tu vault.
MP_TOKEN_ENCRYPTION_KEY=base64url_de_32_bytes
MP_WEBHOOK_SECRET=tu_firma_secreta_de_webhook
MP_WEBHOOK_URL=https://api.tudominio.com/webhooks/mercadopago
MP_TIMEOUT=30000
MP_RETRY_ATTEMPTS=3
MP_RETRY_DELAY=1000

# ── Resend (correos transaccionales) ────────────────────────────────────────────
# Obtén tu API key en: https://resend.com/api-keys
RESEND_API_KEY=re_...
# Remitente verificado en Resend (dominio propio; un correo personal no sirve en producción).
RESEND_FROM_EMAIL=no-reply@tudominio.com
# ID del template de bienvenida creado en Resend (Dashboard → Templates).
RESEND_TEMPLATE_ID_WELCOME=welcome-registration

# ── Frontend (usado para armar links dentro de los correos) ────────────────────
FRONTEND_URL=http://localhost:5173

# ── App ───────────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute
FEATURE_CACHE_TTL=300
